# Copy this file to .env.local and paste your key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the default model
# GEMINI_MODEL=gemini-flash-lite-latest

# Optional: lets students sign in with Google to sync Google Classroom (see docs/google-classroom-setup.md)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Accounts (log in on any device). See docs/accounts-setup.md.
# Added automatically when you connect "Upstash for Redis" in Vercel → Storage:
KV_REST_API_URL=
KV_REST_API_TOKEN=
# A long random secret that signs login cookies (make one with: openssl rand -base64 32)
AUTH_SECRET=
